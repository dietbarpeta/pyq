'params':{}
};
</script>
<script src="https://www.highrevenueformat.com/fc74e8a0c75e512e491a8c53dfb14359/invoke.js"></script>

</div>
</div>

</div>


<footer>
Powered by <b>incognito</b>
</footer>


<!-- =====================================================
     FLOATING PROFILE POPUP
===================================================== -->

<div class="profile-popup" id="profilePopup">

<div class="profile-popup-box">

<button
class="profile-close"
id="profileClose"
aria-label="Close Profile">

<i class="fa fa-xmark"></i>

</button>


<!-- PROFILE -->
<iframe
class="profile-frame"
src="profile.html"
title="Profile"
loading="lazy">
</iframe>


<!-- FLOATING MENU BOTTOM AD -->
<div id="floating300Ad">

<div id="floating300AdBox">

<script>
atOptions={
'key':'fc74e8a0c75e512e491a8c53dfb14359',
'format':'iframe',
'height':250,
'width':300,
'params':{}
};
</script>

<script src="https://www.highrevenueformat.com/fc74e8a0c75e512e491a8c53dfb14359/invoke.js"></script>

</div>

</div>

</div>
</div>


<script>

/* =====================================================
   AD CONFIG
   true = ON
   false = OFF
===================================================== */

const AD_CONFIG={

desktop728:true,

mobile320:true,

desktop468:true,

native:true,

sidebar300:true,

sidebar600:true,

content300:true,

floating300:true

};


/* =====================================================
   AD SETUP
===================================================== */

function setupAds(){

const ads={
desktop728:"desktop728Ad",
mobile320:"mobile320Ad",
desktop468:"desktop468Ad",
native:"nativeAd",
sidebar300:"sidebar300",
sidebar600:"sidebar600",
content300:"content300Ad",
floating300:"floating300Ad"
};

Object.keys(ads).forEach(key=>{

const el=document.getElementById(ads[key]);

if(!el)return;

if(AD_CONFIG[key]===false){

el.style.display="none";

}

});

}

setupAds();


/* =====================================================
   PROFILE POPUP
===================================================== */

const profilePopup=
document.getElementById("profilePopup");

const profileClose=
document.getElementById("profileClose");


function closeProfile(){

profilePopup.classList.add("closed");

}


profileClose.addEventListener(
"click",
closeProfile
);


profilePopup.addEventListener(
"click",
function(e){

if(e.target===profilePopup){

closeProfile();

}

});


document.addEventListener(
"keydown",
function(e){

if(e.key==="Escape"){

closeProfile();

}

});


/* =====================================================
   PAPER SYSTEM
===================================================== */

let apiData=null;

let currentSem="all";


const searchInput=
document.getElementById("search");

const content=
document.getElementById("content");

const semMenu=
document.getElementById("semMenu");

const count=
document.getElementById("count");


/* =====================================================
   LOAD API
===================================================== */

async function loadData(){

try{

const response=
await fetch(
"https://raw.githubusercontent.com/assamboardpapers/assam-deled-scraper/refs/heads/main/api/pdf.json",
{
cache:"no-store"
}
);

if(!response.ok){

throw new Error(
"API request failed"
);

}

apiData=
await response.json();


if(!apiData.years){

throw new Error(
"Invalid API data"
);

}


count.textContent=
apiData.total||0;


createSemesterMenu();

render(apiData);

}

catch(error){

console.error(
"Paper API Error:",
error
);

count.textContent="0";

content.innerHTML=`

<div style="
text-align:center;
padding:45px 20px;
color:#94a3b8;
">

<i
class="fa fa-circle-exclamation"
style="
font-size:36px;
color:#ef4444;
margin-bottom:12px;
">
</i>

<div>
Unable to load papers.
</div>

</div>

`;

}

}

loadData();


/* =====================================================
   GET SEMESTER
===================================================== */

function getSemester(value){

if(!value)return null;

const match=
String(value).match(
/(\d)-sem/i
);

return match?match[1]:null;

}


/* =====================================================
   ESCAPE HTML
===================================================== */

function escapeHTML(value){

return String(value??"")
.replace(/&/g,"&amp;")
.replace(/</g,"&lt;")
.replace(/>/g,"&gt;")
.replace(/"/g,"&quot;")
.replace(/'/g,"&#039;");

}


/* =====================================================
   ESCAPE REGEX
===================================================== */

function escapeRegex(value){

return String(value).replace(
/[.*+?^${}()|[\]\\]/g,
"\\$&"
);

}


/* =====================================================
   HIGHLIGHT
===================================================== */

function highlight(text,query){

const safeText=
escapeHTML(text);

if(!query){

return safeText;

}

const safeQuery=
escapeRegex(query);

return safeText.replace(
new RegExp(
"("+safeQuery+")",
"gi"
),
"<mark>$1</mark>"
);

}


/* =====================================================
   CREATE SEMESTER MENU
===================================================== */

function createSemesterMenu(){

const semesters=
new Set();


Object.keys(apiData.years||{})
.forEach(year=>{

const papers=
Array.isArray(
apiData.years[year]
)
?apiData.years[year]
:[];


papers.forEach(paper=>{

const sem=
getSemester(
paper.class
);

if(sem){

semesters.add(
parseInt(sem,10)
);

}

});

});


const sorted=
[...semesters].sort(
(a,b)=>a-b
);


let html=`

<div
class="sem active"
data-sem="all">

All

</div>

`;


sorted.forEach(sem=>{

html+=`

<div
class="sem"
data-sem="${sem}">

Semester ${sem}

</div>

`;

});


semMenu.innerHTML=html;


semMenu
.querySelectorAll(".sem")
.forEach(button=>{

button.addEventListener(
"click",
function(){

semMenu
.querySelectorAll(".sem")
.forEach(item=>
item.classList.remove(
"active"
)
);

this.classList.add(
"active"
);

currentSem=
this.dataset.sem;

render(apiData);

}
);

});

}


/* =====================================================
   RENDER
===================================================== */

function render(data){

if(!data||!data.years){

content.innerHTML="";

return;

}


const query=
searchInput.value
.trim()
.toLowerCase();


const years=
Object.keys(data.years)
.sort(
(a,b)=>
Number(b)-Number(a)
);


let html="";

let firstOpen=true;


years.forEach(year=>{

const papers=
Array.isArray(
data.years[year]
)
?data.years[year]
:[];


let cards="";


papers.forEach(paper=>{

const sem=
getSemester(
paper.class
);


if(
currentSem!=="all" &&
sem!==currentSem
){

return;

}


const title=
highlight(
paper.title||"",
query
);


const paperURL=
escapeHTML(
paper.url||"#"
);


cards+=`

<div class="card">

<div>

<div class="title">

<i class="fa fa-file-pdf"></i>

${title}

</div>


<div class="meta">

<span>
${escapeHTML(
paper.class||""
)}
</span>


<span
class="badge sem${sem||""}">

<i class="fa fa-layer-group"></i>

Sem ${sem||"-"}

</span>

</div>

</div>


<div class="btn">

<a
class="view"
target="_blank"
rel="noopener noreferrer"
href="${paperURL}">

<i class="fa fa-eye"></i>

View

</a>


<a
class="download"
href="${paperURL}"
download
rel="noopener">

<i class="fa fa-download"></i>

</a>

</div>

</div>

`;

});


if(!cards)return;


html+=`

<div
class="year ${firstOpen?"open":""}">

<div
class="year-header"
onclick="toggleYear(this)">

<span>

<i class="fa fa-calendar"></i>

${escapeHTML(year)}

</span>

<i class="fa fa-chevron-down"></i>

</div>


<div class="grid">

${cards}

</div>

</div>

`;


firstOpen=false;

});


content.innerHTML=html;


/* FIX: প্রথম year-এর height ঠিকভাবে সেট করা */

const first=
content.querySelector(
".year.open .grid"
);

if(first){

requestAnimationFrame(()=>{

first.style.height=
first.scrollHeight+"px";

setTimeout(()=>{

if(first.parentElement.classList.contains("open")){

first.style.height="auto";

}

},350);

});

}

}


/* =====================================================
   YEAR TOGGLE
===================================================== */

function toggleYear(header){

const box=
header.parentElement;

const grid=
box.querySelector(".grid");


if(!grid)return;


if(box.classList.contains("open")){

grid.style.height=
grid.scrollHeight+"px";


requestAnimationFrame(()=>{

grid.style.height="0px";

});


box.classList.remove("open");

}

else{

box.classList.add("open");

grid.style.height=
grid.scrollHeight+"px";


setTimeout(()=>{

if(box.classList.contains("open")){

grid.style.height="auto";

}

},350);

}

}


/* =====================================================
   SEARCH
===================================================== */

searchInput.addEventListener(
"input",
function(){

if(!apiData)return;


const query=
this.value
.trim()
.toLowerCase();


const filtered={
years:{},
total:0
};


Object.keys(apiData.years||{})
.forEach(year=>{

const papers=
Array.isArray(
apiData.years[year]
)
?apiData.years[year]
:[];


const items=
papers.filter(
paper=>
String(
paper.title||""
)
.toLowerCase()
.includes(query)
);


if(items.length){

filtered.years[year]=items;

filtered.total+=
items.length;

}

});


count.textContent=
filtered.total;


render(filtered);

});

</script>

</body>
</html>
