<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">

<title>DELED Previous Year Papers</title>

<meta name="theme-color" content="#0f172a">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="msapplication-navbutton-color" content="#0f172a">

<link rel="icon" type="image/png" href="favicon.png">
<link rel="shortcut icon" href="favicon.png">
<link rel="apple-touch-icon" href="favicon.png">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
background:linear-gradient(180deg,#0f172a,#020617);
color:#fff;
min-height:100vh
}
header{
background:#020617;
padding:20px;
text-align:center;
font-size:22px;
font-weight:600;
border-bottom:1px solid #1e293b;
box-shadow:0 3px 12px rgba(0,0,0,.45)
}

/* ADS */
.ad{
width:100%;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}
.ad iframe{max-width:100%;border:0}

/* TOP 728 */
#desktop728Ad{
display:flex;
min-height:90px;
padding:10px 5px
}
#desktop728AdBox{
width:728px;
height:90px;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}

/* MOBILE 320 */
#mobile320Ad{
display:none;
min-height:50px;
padding:5px
}
#mobile320AdBox{
width:320px;
height:50px;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}

/* MAIN */
.container{
width:100%;
max-width:1200px;
margin:auto;
padding:20px
}

/* SEARCH */
.topbar{
display:flex;
gap:10px;
flex-wrap:wrap;
margin-bottom:15px
}
.search{
flex:1;
min-width:180px
}
.search input{
width:100%;
padding:12px;
border:0;
border-radius:12px;
background:#1e293b;
color:#fff;
font-size:15px;
outline:0
}
.search input::placeholder{color:#94a3b8}
.counter{
padding:12px 14px;
background:#1e293b;
border-radius:12px;
font-size:14px
}

/* 468 */
#desktop468Ad{
display:flex;
width:100%;
min-height:60px;
padding:5px;
margin-bottom:15px
}
#desktop468AdBox{
width:468px;
height:60px;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}

/* SEMESTER */
.sem-wrapper{
position:sticky;
top:0;
z-index:100;
background:#0f172a
}
.sem-menu{
display:flex;
gap:10px;
overflow-x:auto;
padding:12px 0;
scrollbar-width:none
}
.sem-menu::-webkit-scrollbar{display:none}
.sem{
flex:0 0 auto;
background:#1e293b;
padding:8px 18px;
border-radius:30px;
cursor:pointer;
white-space:nowrap;
font-size:14px;
transition:.25s;
border:1px solid #334155;
font-weight:500
}
.sem:hover{background:#334155}
.sem.active{
background:#3b82f6;
border-color:#3b82f6;
box-shadow:0 0 12px rgba(59,130,246,.6)
}

/* CONTENT */
.content-area{
display:grid;
grid-template-columns:minmax(0,1fr) 160px;
gap:20px;
align-items:start
}

/* YEAR */
.year{
margin-bottom:20px;
border-radius:14px;
overflow:hidden;
border:1px solid #1e293b;
background:#020617
}
.year-header{
padding:15px 18px;
display:flex;
justify-content:space-between;
align-items:center;
cursor:pointer;
font-weight:500;
font-size:15px
}
.year-header:hover{background:#1e293b}
.grid{
display:grid;
grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
gap:12px;
padding:0 15px;
height:0;
overflow:hidden;
transition:height .35s ease
}
.year.open .grid{padding:15px}
.year.open .fa-chevron-down{
transform:rotate(180deg);
transition:.3s
}

/* CARD */
.card{
background:rgba(30,41,59,.95);
border-radius:14px;
padding:15px;
display:flex;
flex-direction:column;
justify-content:space-between;
transition:.25s;
border:1px solid #334155;
min-width:0
}
.card:hover{
transform:translateY(-5px);
box-shadow:0 10px 24px rgba(0,0,0,.55);
background:#334155
}
.title{
font-size:14px;
margin-bottom:10px;
line-height:1.4;
font-weight:500;
word-break:break-word
}
.meta{
font-size:12px;
color:#94a3b8;
display:flex;
justify-content:space-between;
align-items:center;
gap:8px;
margin-bottom:10px
}
.badge{
font-size:11px;
padding:4px 10px;
border-radius:20px;
font-weight:500;
display:inline-flex;
align-items:center;
gap:4px;
white-space:nowrap
}
.badge.sem1{
background:#16a34a33;
color:#22c55e;
border:1px solid #22c55e66
}
.badge.sem2{
background:#2563eb33;
color:#3b82f6;
border:1px solid #3b82f666
}
.badge.sem3{
background:#9333ea33;
color:#c084fc;
border:1px solid #a855f766
}
.badge.sem4{
background:#ea580c33;
color:#fb923c;
border:1px solid #fb923c66
}

/* BUTTON */
.btn{
display:flex;
gap:8px
}
.btn a{
flex:1;
text-align:center;
padding:8px;
border-radius:10px;
text-decoration:none;
font-size:13px;
color:#fff;
font-weight:500;
transition:.2s
}
.view{background:#3b82f6}
.download{background:#22c55e}
.view:hover{background:#2563eb}
.download:hover{background:#16a34a}

/* SEARCH */
mark{
background:#facc15;
color:#000;
padding:1px 3px;
border-radius:3px
}

/* SIDEBAR */
.sidebar{
display:flex;
flex-direction:column;
gap:20px;
position:sticky;
top:75px;
width:160px
}
.sidebar-ad{
width:160px;
margin:auto;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}
.sidebar300{height:300px}
.sidebar600{height:600px}

/* NATIVE */
#nativeAd{
width:100%;
display:flex;
justify-content:center;
align-items:center;
margin:30px 0 20px;
padding:0 5px;
overflow:hidden
}
#nativeAdBox{
width:100%;
max-width:900px;
min-height:0;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}

/* CONTENT 300 */
#content300Ad{
width:100%;
display:flex;
justify-content:center;
align-items:center;
padding:5px 5px 30px;
overflow:hidden
}
#content300AdBox{
width:300px;
height:250px;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}

/* FOOTER */
footer{
text-align:center;
padding:20px;
color:#64748b;
font-size:13px
}

/* PROFILE POPUP */
.profile-popup{
position:fixed;
inset:0;
z-index:9999;
display:flex;
align-items:center;
justify-content:center;
padding:10px;
background:rgba(0,0,0,.78);
backdrop-filter:blur(8px);
-webkit-backdrop-filter:blur(8px);
opacity:1;
visibility:visible;
transition:.3s ease
}
.profile-popup.closed{
opacity:0;
visibility:hidden;
pointer-events:none
}
.profile-popup-box{
position:relative;
width:min(500px,100%);
height:min(700px,calc(100dvh - 20px));
background:#020617;
border:1px solid #334155;
border-radius:20px;
overflow:hidden;
box-shadow:0 25px 80px rgba(0,0,0,.75),0 0 30px rgba(59,130,246,.12);
display:flex;
flex-direction:column;
animation:profilePopupIn .35s ease
}
.profile-frame{
width:100%;
height:auto;
min-height:0;
flex:1 1 auto;
border:0;
display:block;
background:#020617
}

/* FLOATING AD */
#floating300Ad{
width:100%;
height:250px;
min-height:250px;
flex:0 0 250px;
display:flex;
justify-content:center;
align-items:center;
background:#020617;
overflow:hidden
}
#floating300AdBox{
width:300px;
height:250px;
display:flex;
justify-content:center;
align-items:center;
overflow:hidden
}

/* CLOSE */
.profile-close{
position:absolute;
top:8px;
right:8px;
z-index:50;
width:38px;
height:38px;
border:1px solid #475569;
border-radius:50%;
background:rgba(15,23,42,.95);
color:#fff;
font-size:18px;
display:flex;
align-items:center;
justify-content:center;
cursor:pointer;
box-shadow:0 4px 15px rgba(0,0,0,.4);
transition:.2s
}
.profile-close:hover{
background:#ef4444;
border-color:#ef4444;
transform:rotate(90deg)
}

@keyframes profilePopupIn{
from{opacity:0;transform:scale(.92) translateY(20px)}
to{opacity:1;transform:scale(1) translateY(0)}
}

/* MOBILE */
@media(max-width:700px){

header{
font-size:19px;
padding:17px 10px
}

#desktop728Ad,
#desktop468Ad{
display:none
}

#mobile320Ad{display:flex}

.container{
padding:10px 12px
}

.topbar{
gap:8px;
margin-bottom:10px
}

.search{
width:100%;
min-width:0
}

.counter{
width:100%;
text-align:center;
padding:11px
}

.sem-wrapper{
margin-left:-12px;
margin-right:-12px;
padding:0 12px
}

.content-area{
display:block
}

.sidebar{
display:none
}

.grid{
grid-template-columns:1fr;
gap:10px;
padding:0 10px
}

.year.open .grid{
padding:10px
}

#nativeAd{
margin:25px 0 15px
}

#content300Ad{
padding:5px 0 25px
}

.profile-popup{
padding:8px
}

.profile-popup-box{
width:100%;
height:calc(100dvh - 16px);
max-height:calc(100dvh - 16px);
border-radius:18px
}

.profile-frame{
min-height:0;
flex:1 1 auto
}

#floating300Ad{
height:250px;
min-height:250px;
flex:0 0 250px
}

.profile-close{
top:8px;
right:8px;
width:36px;
height:36px
}
}

@media(max-width:360px){

.container{padding:10px}

.sem-wrapper{
margin-left:-10px;
margin-right:-10px;
padding:0 10px
}

.card{padding:12px}

}
</style>
</head>

<body>

<header>
<i class="fa fa-book"></i>
DELED Previous Year Papers
</header>


<!-- DESKTOP 728x90 -->
<div id="desktop728Ad" class="ad">
<div id="desktop728AdBox">

